apiVersion: v1
kind: Pod
metadata:
  name: frontend-pod
spec:
  restartPolicy: Always
  containers:
    - name: frontend-plugin
      image: ${tpl.image}
      ports:
        - containerPort: 4000
          hostPort: 4000
      envFrom:
       - configMapRef:
           name: contract.config.map
           optional: false
      env:
        - name: PORT 
          value: "4000"
        - name: COMPONENT
          value: "frontend_plugin"
        - name: HMZ_USER_SK
          value: "${tpl.HMZ_USER_SK}"
        - name: VAULTID
          value: "${tpl.VAULTID}"
        - name: HMZ_AUTH_HOSTNAME
          value: "${tpl.HMZ_AUTH_HOSTNAME}"
        - name: HMZ_AUTH_CUSTOMERID
          value: "${tpl.HMZ_AUTH_CUSTOMERID}"
        - name: HMZ_AUTH_PATH
          value: "${tpl.HMZ_AUTH_PATH}"
        - name: HMZ_API_HOSTNAME
          value: "${tpl.HMZ_API_HOSTNAME}"
        - name: ROOTCERT
          value: "${tpl.ROOTCERT}"
        - name: OSOENCRYPTIONPASS
          value: "${tpl.OSOENCRYPTIONPASS}"
        - name: TOKEN_EXP
          value: "${tpl.TOKEN_EXP}"
        - name: CONFIRMATION_FINGERPRINT
          valueFrom:
            configMapKeyRef:
              name: contract.config.map
              key: CONFIRMATION_FINGERPRINT
              optional: false
        - name: COMPONENT_CA_CERT
          valueFrom:
            configMapKeyRef:
              name: contract.config.map
              key: certs__ca
              optional: false
        - name: FRONTEND_KEY
          valueFrom:
            configMapKeyRef:
              name: contract.config.map
              key: certs__app_key
              optional: false
        - name: FRONTEND_CERT
          valueFrom:
            configMapKeyRef:
              name: contract.config.map
              key: certs__app_crt
              optional: false
        - name: mode
          valueFrom:
            configMapKeyRef:
              name: contract.config.map
              key: mode
              optional: false
