version: '3.6'

services:
  cold-bridge:
    image: ${tpl.cold_bridge_image}
    environment:
      # This must be same as VAULT_ID below
      Vault__Ids__0: 196ff6bf-1b35-4570-a548-55f4d2c4e0c5
      Vault__Ids__1: b5c95ea1-0e12-4b2f-8426-87c572b99d09
      Vault__Ids__2: 1e14abd7-9086-4196-8385-a74907fee202
      Vault__Ids__3: 4a2b3c11-93c2-4b9f-affd-ff6893774b98
      Vault__Ids__4: 11111111-1111-1111-1111-111111111111

      # Passphrase: "{{EMPTY}}" is needed so that the bridge data is not cyphered and can be managed by OSO
      Passphrase: "${tpl.passphrase}"
    restart: always
    volumes:
      - "/mnt/data:/App_Data"

  kmsconnect0:
    image: ${tpl.kmsconnect_image}
    volumes:
      - "./ibm0.cfg:/app/cfg/ibm.cfg:Z"
      - "./cert:/data/cert:ro,Z"
    restart: always

  cold-vault0:
    image: ${tpl.cold_vault_image}
    depends_on:
      - cold-bridge
      - kmsconnect
    environment:
      PLATFORM: kms
      VAULT_BRIDGE_LOGLEVEL: 6
      VAULT_CORE_LOGLEVEL: 3
      VAULT_KMS_ENDPOINT: kmsconnect0:10000
      VAULT_TRUSTED_SIG: ${tpl.notary_messaging_public_key}
      VAULT_ID: 196ff6bf-1b35-4570-a548-55f4d2c4e0c5
      # This comes from the docker container that is spun up above. If it's normal vault, then it would be API end point.
      HARMONIZE_CORE_ENDPOINT: http://cold-bridge:8080/internal/v1
      HMZ_FEATURE_OPTIONAL_MAXIMUM_FEE: 'true'
    restart: always

  kmsconnect1:
    image: ${tpl.kmsconnect_image}
    volumes:
      - "./ibm1.cfg:/app/cfg/ibm.cfg:Z"
      - "./cert:/data/cert:ro,Z"
    restart: always

  cold-vault1:
    image: ${tpl.cold_vault_image}
    depends_on:
      - cold-bridge
      - kmsconnect
    environment:
      PLATFORM: kms
      VAULT_BRIDGE_LOGLEVEL: 6
      VAULT_CORE_LOGLEVEL: 3
      VAULT_KMS_ENDPOINT: kmsconnect1:10000
      VAULT_TRUSTED_SIG: ${tpl.notary_messaging_public_key}
      VAULT_ID: b5c95ea1-0e12-4b2f-8426-87c572b99d09
      # This comes from the docker container that is spun up above. If it's normal vault, then it would be API end point.
      HARMONIZE_CORE_ENDPOINT: http://cold-bridge:8080/internal/v1
      HMZ_FEATURE_OPTIONAL_MAXIMUM_FEE: 'true'
    restart: always
  
  kmsconnect2:
    image: ${tpl.kmsconnect_image}
    volumes:
      - "./ibm2.cfg:/app/cfg/ibm.cfg:Z"
      - "./cert:/data/cert:ro,Z"
    restart: always

  cold-vault2:
    image: ${tpl.cold_vault_image}
    depends_on:
      - cold-bridge
      - kmsconnect
    environment:
      PLATFORM: kms
      VAULT_BRIDGE_LOGLEVEL: 6
      VAULT_CORE_LOGLEVEL: 3
      VAULT_KMS_ENDPOINT: kmsconnect2:10000
      VAULT_TRUSTED_SIG: ${tpl.notary_messaging_public_key}
      VAULT_ID: 1e14abd7-9086-4196-8385-a74907fee202
      # This comes from the docker container that is spun up above. If it's normal vault, then it would be API end point.
      HARMONIZE_CORE_ENDPOINT: http://cold-bridge:8080/internal/v1
      HMZ_FEATURE_OPTIONAL_MAXIMUM_FEE: 'true'
    restart: always

  kmsconnect3:
    image: ${tpl.kmsconnect_image}
    volumes:
      - "./ibm3.cfg:/app/cfg/ibm.cfg:Z"
      - "./cert:/data/cert:ro,Z"
    restart: always

  cold-vault3:
    image: ${tpl.cold_vault_image}
    depends_on:
      - cold-bridge
      - kmsconnect
    environment:
      PLATFORM: kms
      VAULT_BRIDGE_LOGLEVEL: 6
      VAULT_CORE_LOGLEVEL: 3
      VAULT_KMS_ENDPOINT: kmsconnect3:10000
      VAULT_TRUSTED_SIG: ${tpl.notary_messaging_public_key}
      VAULT_ID: 4a2b3c11-93c2-4b9f-affd-ff6893774b98
      # This comes from the docker container that is spun up above. If it's normal vault, then it would be API end point.
      HARMONIZE_CORE_ENDPOINT: http://cold-bridge:8080/internal/v1
      HMZ_FEATURE_OPTIONAL_MAXIMUM_FEE: 'true'
    restart: always
  
  kmsconnect4:
    image: ${tpl.kmsconnect_image}
    volumes:
      - "./ibm4.cfg:/app/cfg/ibm.cfg:Z"
      - "./cert:/data/cert:ro,Z"
    restart: always

  cold-vault4:
    image: ${tpl.cold_vault_image}
    depends_on:
      - cold-bridge
      - kmsconnect
    environment:
      PLATFORM: kms
      VAULT_BRIDGE_LOGLEVEL: 6
      VAULT_CORE_LOGLEVEL: 3
      VAULT_KMS_ENDPOINT: kmsconnect4:10000
      VAULT_TRUSTED_SIG: ${tpl.notary_messaging_public_key}
      VAULT_ID: 11111111-1111-1111-1111-111111111111
      # This comes from the docker container that is spun up above. If it's normal vault, then it would be API end point.
      HARMONIZE_CORE_ENDPOINT: http://cold-bridge:8080/internal/v1
      HMZ_FEATURE_OPTIONAL_MAXIMUM_FEE: 'true'
    restart: always


  backend-plugin:
    image: ${tpl.backend_plugin_image}
    depends_on:
      - cold-vault
    ports:
      - "$${PORT}:$${PORT}"
    environment:
      COMPONENT: "backend_plugin"
      OSOENCRYPTIONPASS: "${tpl.seed}"
      BACKEND_ENDPOINT: http://cold-bridge:8080
      PORT: 4000
      BRIDGE_FINGERPRINT: $${BRIDGE_FINGERPRINT}
      COMPONENT_CA_CERT: $${certs__ca}
      BACKEND_KEY: $${certs__app_key}
      BACKEND_CERT: $${certs__app_crt}
    restart: always
