version: '3.6'

services:
  cold-bridge-${tpl.vault_id}:
    image: ${tpl.cold_bridge_image}
    environment:
      # Passphrase: "{{EMPTY}}" is needed so that the bridge data is not cyphered and can be managed by OSO
      Passphrase: "${tpl.passphrase}"
    restart: always

  kmsconnect-${tpl.vault_id}:
    image: ${tpl.kmsconnect_image}
    volumes:
      - "./ibm.cfg:/app/cfg/ibm.cfg:Z"
      - "./cert:/data/cert:ro,Z"
    restart: always

  cold-vault-${tpl.vault_id}:
    image: ${tpl.cold_vault_image}
    depends_on:
      - cold-bridge-${tpl.vault_id}
      - kmsconnect-${tpl.vault_id}
    environment:
      PLATFORM: kms
      VAULT_BRIDGE_LOGLEVEL: 6
      VAULT_CORE_LOGLEVEL: 3
      VAULT_KMS_ENDPOINT: kmsconnect-${tpl.vault_id}:10000
      VAULT_TRUSTED_SIG: ${tpl.notary_messaging_public_key}
      VAULT_ID: ${tpl.vault_id}
      # This comes from the docker container that is spun up above. If it's normal vault, then it would be API end point.
      HARMONIZE_CORE_ENDPOINT: http://cold-bridge-${tpl.vault_id}:8080/internal/v1
      HMZ_FEATURE_OPTIONAL_MAXIMUM_FEE: 'true'
    restart: always


  cold-bridge-b5c95ea1-0e12-4b2f-8426-87c572b99d09:
    image: ${tpl.cold_bridge_image}
    environment:
      Passphrase: "${tpl.passphrase}"
    restart: always

  vault-releases-b5c95ea1-0e12-4b2f-8426-87c572b99d09:
    image: ${tpl.cold_vault_image}
    depends_on:
      - cold-bridge-b5c95ea1-0e12-4b2f-8426-87c572b99d09

    environment:
      PLATFORM: mock
      MOCK_PHRASE: ibmosocold

      # This is the notary public key if it's mock
      TRUSTED_SIG: ed25519:50692dfa472f013e2f87e5d210be40cefe178e33787be4688d5da0afe06ed149
      VAULT_ID: b5c95ea1-0e12-4b2f-8426-87c572b99d09

      # This comes from the docker container that is spun up above. If it's normal vault, then it would be API end point.
      HARMONIZE_CORE_ENDPOINT: http://cold-bridge-b5c95ea1-0e12-4b2f-8426-87c572b99d09:8080/internal/v1
    restart: always

    volumes:
      - ./mock-cfg/vault.cfg:/opt/vault-core/cfg/vault.cfg
      - ./mock-cfg/mock.cfg:/opt/vault-core/cfg/mock.cfg
  


  cold-bridge-1e14abd7-9086-4196-8385-a74907fee202:
    image: ${tpl.cold_bridge_image}
    environment:
      Passphrase: "${tpl.passphrase}"
    restart: always
 
  vault-releases-1e14abd7-9086-4196-8385-a74907fee202:
    image: ${tpl.cold_vault_image}
    depends_on:
      - cold-bridge-1e14abd7-9086-4196-8385-a74907fee202

    environment:
      PLATFORM: mock
      MOCK_PHRASE: ibmosocold2

      # This is the notary public key if it's mock
      TRUSTED_SIG: ed25519:50692dfa472f013e2f87e5d210be40cefe178e33787be4688d5da0afe06ed149
      VAULT_ID: 1e14abd7-9086-4196-8385-a74907fee202
      HMZ_LOG_LEVEL: "DEBUG"
      HARMONIZE_CORE_ENDPOINT: http://cold-bridge-1e14abd7-9086-4196-8385-a74907fee202:8080/internal/v1
    restart: always

    volumes:
      - ./mock-cfg/vault.cfg:/opt/vault-core/cfg/vault.cfg
      - ./mock-cfg/mock.cfg:/opt/vault-core/cfg/mock.cfg



  cold-bridge-4a2b3c11-93c2-4b9f-affd-ff6893774b98:
    image: ${tpl.cold_bridge_image}
    environment:
      Passphrase: "${tpl.passphrase}"
    restart: always

  vault-releases-4a2b3c11-93c2-4b9f-affd-ff6893774b98:
    image: ${tpl.cold_vault_image}
    depends_on:
      - cold-bridge-4a2b3c11-93c2-4b9f-affd-ff6893774b98

    environment:
      PLATFORM: mock
      MOCK_PHRASE: ibmosocold4

      # This is the notary public key if it's mock
      TRUSTED_SIG: ed25519:50692dfa472f013e2f87e5d210be40cefe178e33787be4688d5da0afe06ed149
      VAULT_ID: 4a2b3c11-93c2-4b9f-affd-ff6893774b98

      # This comes from the docker container that is spun up above. If it's normal vault, then it would be API end point.
      HARMONIZE_CORE_ENDPOINT: http://cold-bridge-4a2b3c11-93c2-4b9f-affd-ff6893774b98:8080/internal/v1
    restart: always

    volumes:
      - ./mock-cfg/vault.cfg:/opt/vault-core/cfg/vault.cfg
      - ./mock-cfg/mock.cfg:/opt/vault-core/cfg/mock.cfg



  cold-bridge-11111111-1111-1111-1111-111111111111:
    image: ${tpl.cold_bridge_image}
    environment:
      Passphrase: "${tpl.passphrase}"
    restart: always
 
  vault-releases-11111111-1111-1111-1111-111111111111:
    image: ${tpl.cold_vault_image}
    depends_on:
      - cold-bridge-11111111-1111-1111-1111-111111111111

    environment:
      PLATFORM: mock
      MOCK_PHRASE: 22222222222222222222222222222222222222222222222222222222222222222222222222222222222222222222222222222222222222222222222222222222
      VAULT_LOG_LEVEL: "DEBUG"
      # This is the notary public key if it's mock
      TRUSTED_SIG: ed25519:50692dfa472f013e2f87e5d210be40cefe178e33787be4688d5da0afe06ed149
      VAULT_ID: 11111111-1111-1111-1111-111111111111
      # This comes from the docker container that is spun up above. If it's normal vault, then it would be API end point.
      HARMONIZE_CORE_ENDPOINT: http://cold-bridge-11111111-1111-1111-1111-111111111111:8080/internal/v1
    restart: always
    
    volumes:
      - ./mock-cfg/vault.cfg:/opt/vault-core/cfg/vault.cfg
      - ./mock-cfg/mock.cfg:/opt/vault-core/cfg/mock.cfg



  backend-plugin:
    image: ${tpl.backend_plugin_image}
    depends_on:
      - cold-vault-${tpl.vault_id}
      - cold-bridge-11111111-1111-1111-1111-111111111111
      - cold-bridge-4a2b3c11-93c2-4b9f-affd-ff6893774b98
      - cold-bridge-b5c95ea1-0e12-4b2f-8426-87c572b99d09
      - cold-bridge-1e14abd7-9086-4196-8385-a74907fee202
    ports:
      - "$${PORT}:$${PORT}"
    environment:
      COMPONENT: "backend_plugin"
      OSOENCRYPTIONPASS: "${tpl.seed}"
      #Does not change
      BACKEND_ENDPOINT: http://cold-bridge
      PORT: 4000
      VAULTIDS: "${tpl.vault_id},11111111-1111-1111-1111-111111111111,4a2b3c11-93c2-4b9f-affd-ff6893774b98,b5c95ea1-0e12-4b2f-8426-87c572b99d09,1e14abd7-9086-4196-8385-a74907fee202"
      BRIDGE_FINGERPRINT: $${BRIDGE_FINGERPRINT}
      COMPONENT_CA_CERT: $${certs__ca}
      BACKEND_KEY: $${certs__app_key}
      BACKEND_CERT: $${certs__app_crt}
      #WHITELISTING: "1"
    restart: always
    volumes:
      - ./whitelists:/whitelists
